{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remedialhq.com/schemas/daily-performance.v1.json",
  "title": "ReMediaLHQ bounded offline daily performance feedback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "performance_date",
    "calendar_sha256",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "remedialhq.daily-performance.v1"
    },
    "performance_date": {
      "type": "string",
      "format": "date",
      "maxLength": 10
    },
    "calendar_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 82,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value"],
      "properties": {
        "metric": {
          "enum": [
            "IMPRESSIONS",
            "SESSIONS",
            "INTENT_SESSIONS",
            "VIEWS",
            "QUALIFIED_VIEWS",
            "QUALIFIED_WATCH_SECONDS",
            "RETURNING_VIEWERS",
            "CLICKS",
            "NEWSLETTER_OPT_INS",
            "AFFILIATE_REVENUE_CENTS",
            "SPONSOR_REVENUE_CENTS",
            "AD_REVENUE_CENTS",
            "PRODUCTION_MINUTES",
            "PRODUCTION_COST_CENTS",
            "COMPUTE_COST_CENTS",
            "CORRECTIONS"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifact_sha256", "record_sha256"],
      "properties": {
        "kind": {
          "enum": [
            "PLATFORM_ANALYTICS_EXPORT",
            "SITE_ANALYTICS_EXPORT",
            "LOCAL_PUBLICATION_LOG"
          ]
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "day_number",
        "calendar_date",
        "opportunity_id",
        "observed_at",
        "publication_result",
        "block_reason",
        "source",
        "metrics"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^prf_[0-9a-f]{32}$"
        },
        "day_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 82
        },
        "calendar_date": {
          "type": "string",
          "format": "date",
          "maxLength": 10
        },
        "opportunity_id": {
          "type": "string",
          "pattern": "^OPP-[0-9]{4}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "publication_result": {
          "enum": ["PUBLISHED", "NOT_PUBLISHED", "BLOCKED"]
        },
        "block_reason": {
          "oneOf": [
            {"type": "null"},
            {
              "enum": [
                "PUBLICATION_AUTHORITY_DISABLED",
                "CALENDAR_STATE_NOT_EXECUTABLE",
                "ASSET_NOT_READY",
                "POLICY_GATE_FAILED",
                "SOURCE_EVIDENCE_UNAVAILABLE"
              ]
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "metrics": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/metric"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "publication_result": {"const": "PUBLISHED"}
            }
          },
          "then": {
            "properties": {
              "block_reason": {"type": "null"},
              "metrics": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "publication_result": {"const": "NOT_PUBLISHED"}
            }
          },
          "then": {
            "properties": {
              "block_reason": {"type": "null"},
              "metrics": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "publication_result": {"const": "BLOCKED"}
            }
          },
          "then": {
            "properties": {
              "block_reason": {"type": "string"},
              "metrics": {"maxItems": 0}
            }
          }
        }
      ]
    }
  }
}
